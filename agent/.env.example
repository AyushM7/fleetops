# Copy to agent/.env and configure privately. The backend must assign proposer role.
FLEETOPS_GRAPHQL_URL=http://127.0.0.1:8080/graphql
FLEETOPS_PROPOSER_TOKEN=

# Live execution still requires --live; submission separately requires --submit.
# Choose a supported provider/model with structured output. Live execution may incur charges.
FLEETOPS_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# Used only with an explicit --demo flag and station-ready backend profile.
FLEETOPS_DEMO_ROBOT_ID=R1
FLEETOPS_DEMO_STATION_ID=S1
