POSTGRES_USER=fleetops
POSTGRES_PASSWORD=change_me_local_only
POSTGRES_DB=fleetops

# Export these in the invoking shell; Go does not automatically read .env.
# Supply a private, URL-escaped PostgreSQL connection URL. Never commit it.
FLEETOPS_DATABASE_URL=
# Integration tests use only this URL and create/drop isolated test schemas.
FLEETOPS_TEST_DATABASE_URL=
# Set to 1 to fail instead of skipping when the test URL is missing.
FLEETOPS_REQUIRE_DB=0
# Hash-only JSON credentials; see backend/graphql/README.md. Never put bearer tokens here.
FLEETOPS_AUTH_TOKENS=
# Opt-in station-ready charging demonstration; no simulator controls are exposed.
FLEETOPS_CHARGING_DEMO=0
# Background dynamics are opt-in. Interval uses Go duration syntax.
FLEETOPS_AUTO_TICK=0
FLEETOPS_TICK_INTERVAL=500ms
