scalar Time

type Query {
  fleetState: FleetState!
  proposal(id: ID!): Proposal
  pendingProposals: [Proposal!]!
  agentRun(id: ID!): AgentRun
  agentRuns(limit: Int!): [AgentRun!]!
}

type Mutation {
  submitProposal(input: SetChargingInput!): MutationResult!
  submitReassignment(input: ReassignUnstartedJobInput!): MutationResult!
  approveProposal(id: ID!): MutationResult!
  rejectProposal(id: ID!): MutationResult!
  startAgentRun(expectedObservationId: String!, metadata: String!): AgentRun!
  finishAgentRun(id: ID!, completion: String!): AgentRunReceipt!
}

# data is the bounded agent-run-v1 JSON contract. It contains typed projections, never raw prompts or tool outputs.
type AgentRun { id: ID!, runtimeId: ID!, observationId: String!, data: String!, proposal: Proposal }
type AgentRunReceipt { runId: ID!, recorded: Boolean!, denial: String!, proposalResult: MutationResult }

input SetChargingInput { robotId: ID!, stationId: ID!, expiresAt: Time!, expectedObservationId: String }
input ReassignUnstartedJobInput { jobId: ID!, fromRobotId: ID!, toRobotId: ID!, expiresAt: Time!, expectedObservationId: String }
type Job { id: ID!, status: String!, assignedRobot: String!, fromX: Int!, fromY: Int!, toX: Int!, toY: Int! }
type ReassignmentCandidate { jobId: ID!, fromRobotId: ID!, toRobotId: ID!, pickupSteps: Int!, deliverySteps: Int!, chargingExitSteps: Int!, requiredBattery: Int! }
type Robot { id: ID!, x: Int!, y: Int!, battery: Int!, status: String!, jobId: String!, waitTicks: Int!, blocked: Boolean! }
type Station { id: ID!, x: Int!, y: Int!, occupiedBy: String!, reservedBy: String! }
type WarehouseCell { x: Int!, y: Int!, kind: String! }
type WarehouseLayout { width: Int!, height: Int!, cells: [WarehouseCell!]! }
type ActiveIncident { robotId: ID!, type: String!, severity: String!, telemetry: Robot! }
type FleetState { observationId: String!, layout: WarehouseLayout!, tick: Int!, robots: [Robot!]!, stations: [Station!]!, poisoned: Boolean!, activeIncidents: [ActiveIncident!]!, jobs: [Job!]!, reassignmentCandidates: [ReassignmentCandidate!]! }
type Proposal {
  id: ID!
  action: String!
  robotId: ID!
  stationId: ID!
  jobId: ID!
  fromRobotId: ID!
  toRobotId: ID!
  createdAt: Time!
  expiresAt: Time!
  state: String!
  execution: String!
  submittedBy: String!
  currentRuntime: Boolean!
}
type MutationResult {
  proposalId: ID!
  state: String!
  execution: String!
  auditCommitted: Boolean!
  executionAttempted: Boolean!
  error: String
}
